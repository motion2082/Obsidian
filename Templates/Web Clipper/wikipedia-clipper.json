{
	"schemaVersion": "0.1.0",
	"name": "Wikipedia",
	"behavior": "create",
	"noteContentFormat": "{{selectorHtml:#mw-content-text|remove_html:(\".navbox,.printfooter,.side-box\")|markdown}}",
	"properties": [
		{
			"name": "Date-Created",
			"value": "{{date}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "#My/Clippings, #Wikipedia",
			"type": "multitext"
		},
		{
			"name": "Category",
			"value": "[[Wikipedia]]",
			"type": "text"
		},
		{
			"name": "Source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "Author",
			"value": "[[Wikipedia]]",
			"type": "text"
		},
		{
			"name": "Description",
			"value": "{{description}}",
			"type": "text"
		}
	],
	"triggers": [
		"/^https:\\/\\/[a-z]{2,3}\\.wikipedia\\.org\\/wiki\\/?$/"
	],
	"noteNameFormat": "{{title}}",
	"path": "04 VAULT/Web Clippings"
}
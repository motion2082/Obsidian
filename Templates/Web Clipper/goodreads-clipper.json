{
	"schemaVersion": "0.1.0",
	"name": "Goodreads",
	"behavior": "create",
	"noteContentFormat": "{{selector:.BookPageMetadataSection__description}}",
	"properties": [
		{
			"name": "Date-Created",
			"value": "{{date}}",
			"type": "text"
		},
		{
			"name": "Date-Completed: ",
			"value": "",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "#Books, #My/WebClippings",
			"type": "multitext"
		},
		{
			"name": "Category:",
			"value": "Books",
			"type": "text"
		},
		{
			"name": "Topics",
			"value": "{{\\\"topics in this article, separated by commas\\\"}}",
			"type": "multitext"
		},
		{
			"name": "Author",
			"value": "{{schema:author[*].name|wikilink|join}}",
			"type": "text"
		},
		{
			"name": "URL",
			"value": "{{url}}",
			"type": "multitext"
		},
		{
			"name": "Rating",
			"value": "⭐⭐⭐⭐",
			"type": "multitext"
		},
		{
			"name": "Priority",
			"value": "",
			"type": "text"
		},
		{
			"name": "Format",
			"value": "",
			"type": "text"
		},
		{
			"name": "Cover",
			"value": "{{schema:image}}",
			"type": "text"
		},
		{
			"name": "Status",
			"value": "In-Progress",
			"type": "text"
		},
		{
			"name": "Genre",
			"value": "{{selector:.BookPageMetadataSection__genres .BookPageMetadataSection__genreButton|wikilink}}",
			"type": "text"
		},
		{
			"name": "Length",
			"value": "{{schema:numberOfPages}}",
			"type": "text"
		},
		{
			"name": "Year",
			"value": "{{selector:p[data-testid='publicationInfo']|split:\\\"First published \\\"|slice:1|date:\\\"YYYY\\\"}}",
			"type": "text"
		},
		{
			"name": "ScoreGr",
			"value": "{{schema:aggregateRating.ratingValue}}",
			"type": "text"
		},
		{
			"name": "isbn",
			"value": "{{schema:isbn}}",
			"type": "text"
		}
	],
	"triggers": [
		"https://www.goodreads.com/book/"
	],
	"noteNameFormat": "{{selector:.BookPageTitleSection__title h1}}",
	"path": "04 VAULT/Web Clippings"
}